# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DB_PATH=/var/data/market-point-pro/db.json
# Optional: managed Postgres storage. If set, this overrides DB_PATH at runtime.
DATABASE_URL=

# Encryption key for wallet address storage (required in production)
WALLET_ENCRYPTION_KEY=replace-with-long-random-secret

# Admin authentication (required for production)
ADMIN_USERNAME=teerex777
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL_HOURS=12
USER_SESSION_TTL_HOURS=24

# Legacy key auth fallback (disable in production)
LEGACY_ADMIN_KEY_ENABLED=false
ADMIN_KEY=

# Email delivery (Resend)
# In production, use a real API key and a verified sender/domain.
# If unset in development, email codes are printed to server logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com

# KYC document storage
# Use provider=s3 for S3, R2, MinIO, or compatible object storage.
# If omitted, documents are stored on local persistent disk at KYC_LOCAL_DIR.
KYC_STORAGE_PROVIDER=
KYC_LOCAL_DIR=/var/data/kyc_docs
KYC_S3_REGION=
KYC_S3_ENDPOINT=
KYC_S3_BUCKET=
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
